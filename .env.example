# Copy thành .env (không commit .env). Dùng chung cho docker-compose và backend.

# Backend
PORT=3000
# Trên server đặt thành https://<DOMAIN>. Nhiều origin thì ngăn bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# Caddy (HTTPS). Trên server đặt domain đã trỏ về IP máy, ví dụ insecurebanking.duckdns.org.
# Bỏ trống thì Caddy dùng localhost với chứng chỉ tự ký
DOMAIN=

# Database
DB_HOST=localhost
DB_PORT=5433
# Owner của schema: migration, seed, dọn dữ liệu test. Backend không dùng user này khi chạy.
DB_USER=bank
DB_PASSWORD=bank_dev_password
# User runtime của backend, tạo bằng `npm run db:app-user` (không sửa/xóa được ledger_entries)
DB_APP_USER=bank_app
DB_APP_PASSWORD=bank_app_dev_password
DB_NAME=banking
DB_SSL=false
DB_LOGGING=false

# Worker xử lý outbox (F5). Bỏ trống thì dùng giá trị mặc định ghi bên cạnh
# Nghỉ giữa hai lần poll khi hết sự kiện (2000)
OUTBOX_POLL_INTERVAL_MS=
# Số sự kiện tối đa mỗi lần poll (20)
OUTBOX_BATCH_SIZE=
# Lỗi đến lần thứ này thì đánh dấu failed (5)
OUTBOX_MAX_ATTEMPTS=
# Chờ trước lần thử lại đầu tiên, các lần sau gấp đôi (5000), tối đa (600000)
OUTBOX_BACKOFF_BASE_MS=
OUTBOX_BACKOFF_MAX_MS=

# JWT (TV2 dùng)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
