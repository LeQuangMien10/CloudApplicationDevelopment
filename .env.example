# Copy thành .env (không commit .env). Dùng chung cho docker-compose và backend.

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5433
# Owner của schema: migration, seed, dọn dữ liệu test. Backend không dùng user này khi chạy.
DB_USER=bank
DB_PASSWORD=bank_dev_password
# User runtime của backend, tạo bằng `npm run db:app-user` (không sửa/xóa được ledger_entries)
DB_APP_USER=bank_app
DB_APP_PASSWORD=bank_app_dev_password
DB_NAME=banking
DB_SSL=false
DB_LOGGING=false

# JWT (TV2 dùng)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
